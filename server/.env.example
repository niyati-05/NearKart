# Copy this file to `.env` and adjust values. Never commit `.env`.
# Server-only secrets/config belong here.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Local MongoDB (MongoDB Compass + local server)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nearkart

# Sessions
SESSION_COOKIE_NAME=nk_session
BCRYPT_SALT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20

# Google Routes API (server-only). Enable the Routes API in Google Cloud and
# restrict this key to the API/server. Never expose it as a VITE_ variable.
# Leave blank to keep delivery estimates explicitly "pending" in the UI.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REQUEST_TIMEOUT_MS=8000

# Delivery pricing in integer paise (₹1 = 100). Rates are rounded up to whole
# kilometres/minutes, then the minimum fee is applied.
DELIVERY_BASE_FEE_PAISE=2000
DELIVERY_PER_KM_PAISE=800
DELIVERY_PER_MINUTE_PAISE=0
DELIVERY_MIN_FEE_PAISE=2000
DELIVERY_MAX_DISTANCE_METERS=25000

# One-time admin bootstrap (npm run seed:admin). Use a strong password and
# remove these two lines after the first admin exists.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
