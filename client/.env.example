# Copy this file to `.env` when you need to override defaults.
# Only variables prefixed with VITE_ are readable by browser code.
# NEVER put server secrets (MongoDB URI, Google Routes key) here.

VITE_API_BASE=/api

# Optional public browser key for the Google Maps JavaScript API. Restrict it
# by HTTP referrer (localhost:5173 and your production domain). This is NOT the
# server Routes API key. Leave blank to show an explicit map-unavailable state.
VITE_GOOGLE_MAPS_API_KEY=
